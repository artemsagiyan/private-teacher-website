# Copy to deploy/.env.prod (deploy.sh does this automatically).
# Do not commit real secrets.

DOMAIN=easyphys.ru
PUBLIC_URL=https://easyphys.ru
PUBLIC_LIVEKIT_URL=wss://live.easyphys.ru

# Strong secrets (deploy.sh generates if empty)
JWT_SECRET=
JWT_REFRESH_SECRET=
DATABASE_PASSWORD=
MINIO_ACCESS_KEY=tutor
MINIO_SECRET_KEY=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional mail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@easyphys.ru

# Lighter defaults for a typical VPS (override if you have 16GB+ RAM)
WHISPER_MODEL=small
OLLAMA_MODEL=qwen2.5:3b

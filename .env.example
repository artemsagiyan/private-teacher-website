# Database
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=tutor_platform

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@tutor-platform.com

# App
PORT=3001
PUBLIC_HOST=localhost
PUBLIC_FRONTEND_PORT=3004
FRONTEND_URL=http://localhost:3004
CORS_ORIGINS=http://localhost:3004,http://127.0.0.1:3004
# For access from other devices, set PUBLIC_HOST to this computer's reachable IP or hostname
# and add its frontend origin to CORS_ORIGINS. Mobile camera access requires HTTPS.
NODE_ENV=production
SMTP_DISABLED=true

# Lesson recording and lifecycle
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=tutor-dev-livekit-secret-key-32chars
LIVEKIT_URL=ws://localhost:7890
LIVEKIT_PUBLIC_URL=ws://localhost:7890
LESSON_EMPTY_TIMEOUT_SECONDS=1800
LESSON_JOIN_EARLY_MINUTES=30
LESSON_JOIN_LATE_MINUTES=120

# S3-compatible file storage (MinIO in docker-compose)
MINIO_ENDPOINT=localhost
MINIO_PORT=9010
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=tutor
MINIO_SECRET_KEY=tutor-secret
MINIO_BUCKET=tutor-files
MINIO_REGION=us-east-1
MINIO_EGRESS_ENDPOINT=http://localhost:9010

# Local AI services
TRANSCRIBER_URL=http://localhost:8000
TRANSCRIBER_LANGUAGE=ru
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_NUM_CTX=16384
WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=1

# Keep report generation on this computer; do not configure a remote worker.
COMPUTE_MODE=local

{
  "name": "tutor-platform",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "npm run start:dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build:backend": "npm run build --workspace=backend",
    "build:frontend": "npm run build --workspace=frontend",
    "test:api": "node test/api.test.mjs",
    "test:backend": "npm test --workspace=backend",
    "test": "npm run test:backend && node --test --experimental-strip-types test/api-error.test.ts test/lesson-join.test.ts"
  }
}
